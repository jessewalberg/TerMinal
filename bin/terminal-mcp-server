#!/usr/bin/env bun
// terminal-mcp-server — Model Context Protocol server exposing TerMinal's
// cross-session state to in-session Claude/Codex agents.
//
// READ tools: cross-session views (tickets, PRs, schedules, runs, spend).
// WRITE tools: deterministic data filing (ticket, hitl, activity, state)
// so agents skip reading ~5-7k tokens of skill files every time they file
// data. Schema decisions stay with the model; schema formatting is done here.

import { readFileSync, readdirSync, existsSync, statSync, writeFileSync, mkdirSync, appendFileSync } from 'node:fs'
import { join, basename, dirname, sep } from 'node:path'
import { randomUUID } from 'node:crypto'
import { homedir } from 'node:os'
// Consolidated ticket writer — installed alongside this script (bin/lib/),
// so the relative import resolves both in-repo and at ~/.config/TerMinal/bin.
import {
  createTicketFile,
  createVaultTicketFile,
  findVaultTaskBySourceId,
  hasProjectionMarker,
  slugify,
  updateTicketFile,
} from './lib/backlog-core.mjs'
import { resolveRoute } from './lib/vault-route.mjs'

const CFG = join(homedir(), '.config', 'TerMinal')
const SETTINGS_FILE = join(CFG, 'settings.json')

function readSettings() {
  try {
    const s = JSON.parse(readFileSync(SETTINGS_FILE, 'utf8'))
    return s && typeof s === 'object' ? s : {}
  } catch {
    return {}
  }
}

function configuredProjectsDir() {
  const s = readSettings()
  return typeof s.projectsDir === 'string' && s.projectsDir ? s.projectsDir : homedir()
}

function configuredHarnessDir() {
  if (process.env.GT_HARNESS_DIR) return process.env.GT_HARNESS_DIR
  const s = readSettings()
  return typeof s.harnessDir === 'string' ? s.harnessDir : ''
}

function prsRoot() {
  const dir = configuredHarnessDir()
  return dir ? join(dir, 'prs') : ''
}

// ---------------------------------------------------------------------------
// Frontmatter parser (mirrors the renderer-side parser; minimal, regex-only)
// ---------------------------------------------------------------------------
function parseFrontmatter(md) {
  const m = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/)
  if (!m) return { meta: {}, body: md }
  const meta = {}
  for (const line of m[1].split(/\r?\n/)) {
    const lm = line.match(/^([A-Za-z_][\w-]*):\s*(.*)$/)
    if (!lm) continue
    const raw = lm[2].trim()
    if (!raw) continue
    let val = raw
    if (raw === 'true' || raw === 'false') val = raw === 'true'
    else if (/^-?\d+(\.\d+)?$/.test(raw)) val = Number(raw)
    else if (raw.startsWith('"') && raw.endsWith('"')) {
      // writers emit titles via JSON.stringify — JSON-unescape when valid
      try {
        val = JSON.parse(raw)
      } catch {
        val = raw.slice(1, -1)
      }
    }
    else if (raw.startsWith('[') && raw.endsWith(']')) {
      val = raw
        .slice(1, -1)
        .split(',')
        .map((s) => s.trim().replace(/^["']|["']$/g, ''))
        .filter(Boolean)
    }
    meta[lm[1]] = val
  }
  return { meta, body: m[2] || '' }
}

// ---------------------------------------------------------------------------
// Resource readers — each delegates to existing on-disk shapes
// ---------------------------------------------------------------------------

function knownRepoRoots() {
  // Repos known to the harness: anything with a schedule, anything in
  // prs/cache.json, anything in the workspaces persisted state, anything in
  // bg-tasks.json.
  const roots = new Set()
  // schedules.json
  try {
    const sf = join(CFG, 'schedules.json')
    if (existsSync(sf)) {
      const arr = JSON.parse(readFileSync(sf, 'utf8'))
      for (const s of arr) if (s.repoRoot) roots.add(s.repoRoot)
    }
  } catch {}
  // bg-tasks.json
  try {
    const bf = join(CFG, 'bg-tasks.json')
    if (existsSync(bf)) {
      const arr = JSON.parse(readFileSync(bf, 'utf8'))
      for (const t of arr) if (t.repoRoot) roots.add(t.repoRoot)
    }
  } catch {}
  // Walk common parent dir to find any repo not yet known
  const parent = configuredProjectsDir()
  if (existsSync(parent)) {
    try {
      for (const name of readdirSync(parent)) {
        const p = join(parent, name)
        if (name.startsWith('.')) continue
        if (existsSync(join(p, '.git'))) roots.add(p)
      }
    } catch {}
  }
  return [...roots]
}

function findRepoRoot(repoArg) {
  if (!repoArg) return null
  const target = repoArg.toLowerCase()
  for (const root of knownRepoRoots()) {
    const b = basename(root).toLowerCase()
    if (b === target || root.toLowerCase().endsWith(target)) return root
  }
  return null
}

// --- tickets ---------------------------------------------------------------

function listTicketsForRoot(repoRoot, filter) {
  const dir = join(repoRoot, 'backlog')
  if (!existsSync(dir)) return []
  const out = []
  let files
  try {
    files = readdirSync(dir)
  } catch {
    return []
  }
  for (const f of files) {
    if (!/^\d{4}-.*\.md$/.test(f)) continue
    let raw
    try {
      raw = readFileSync(join(dir, f), 'utf8')
    } catch {
      continue
    }
    const { meta, body } = parseFrontmatter(raw)
    const slug = f.replace(/\.md$/, '')
    const ticket = {
      slug,
      id: typeof meta.id === 'number' ? meta.id : parseInt(slug.slice(0, 4), 10),
      title: meta.title || slug,
      status: meta.status || 'open',
      priority: meta.priority || 'medium',
      type: meta.type || 'feature',
      horizon: meta.horizon || 'now',
      hitl: meta.hitl === true,
      created: meta.created,
      updated: meta.updated,
      prs: meta.prs || [],
      repo: basename(repoRoot),
      body: body.slice(0, 600), // truncate; agents can fetch full via get_ticket
    }
    if (filter?.status && ticket.status !== filter.status) continue
    if (filter?.type && ticket.type !== filter.type) continue
    out.push(ticket)
  }
  return out.sort((a, b) => a.id - b.id)
}

function listTicketsTool(args) {
  const repo = args.repo
  const roots = repo ? [findRepoRoot(repo)].filter(Boolean) : knownRepoRoots()
  const filter = { status: args.status, type: args.type }
  return roots.flatMap((r) => listTicketsForRoot(r, filter))
}

function getTicketTool(args) {
  const slug = args.slug
  if (!slug) return null
  // Try every known repo until we find it
  for (const root of knownRepoRoots()) {
    const f = join(root, 'backlog', `${slug}.md`)
    if (existsSync(f)) {
      const raw = readFileSync(f, 'utf8')
      const { meta, body } = parseFrontmatter(raw)
      return {
        slug,
        repo: basename(root),
        repoRoot: root,
        ...meta,
        body,
      }
    }
  }
  return null
}

// --- PRs / MRs (from optional harness prs/ artifact store) -----------------

function listPrs(args) {
  const root = prsRoot()
  if (!root || !existsSync(root)) return []
  const out = []
  // prs/<host>/<owner>/<name>/<num>/meta.json
  const walk = (dir, depth = 0) => {
    if (depth > 4) return
    let names
    try {
      names = readdirSync(dir)
    } catch {
      return
    }
    for (const name of names) {
      const p = join(dir, name)
      let st
      try {
        st = statSync(p)
      } catch {
        continue
      }
      if (st.isDirectory()) walk(p, depth + 1)
      else if (name === 'meta.json') {
        try {
          const meta = JSON.parse(readFileSync(p, 'utf8'))
          if (args.repo && !meta.repo?.toLowerCase().includes(args.repo.toLowerCase())) continue
          if (args.status && meta.state !== args.status) continue
          out.push({
            host: meta.host,
            repo: meta.repo,
            number: meta.number,
            title: meta.title,
            state: meta.state,
            webUrl: meta.webUrl,
            author: meta.author,
            updatedAt: meta.updatedAt,
            commits: (meta.commits || []).length,
          })
        } catch {}
      }
    }
  }
  walk(root)
  return out.sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0, 50)
}

function getPrArtifact(args) {
  const { host, repo, number, sha } = args
  if (!host || !repo || !number) return null
  const root = prsRoot()
  if (!root) return null
  const dir = join(root, host, ...repo.split('/'), String(number))
  if (!existsSync(dir)) return null
  // Default sha = first commit in meta.json (newest)
  let targetSha = sha
  if (!targetSha) {
    try {
      const meta = JSON.parse(readFileSync(join(dir, 'meta.json'), 'utf8'))
      targetSha = meta.commits?.[0]?.slice(0, 7)
    } catch {}
  }
  if (!targetSha) return null
  const file = join(dir, `${targetSha}.md`)
  if (!existsSync(file)) return null
  const raw = readFileSync(file, 'utf8')
  const { meta, body } = parseFrontmatter(raw)
  return { host, repo, number, sha: targetSha, meta, body }
}

// --- schedules + agent runs -----------------------------------------------

function listSchedules(args) {
  const sf = join(CFG, 'schedules.json')
  if (!existsSync(sf)) return []
  try {
    const arr = JSON.parse(readFileSync(sf, 'utf8'))
    return arr.filter((s) => !args.repo || s.repoLabel?.toLowerCase().includes(args.repo.toLowerCase()))
  } catch {
    return []
  }
}

function recentAgentRuns(args) {
  const out = []
  // cron-runs/
  const cronDir = join(CFG, 'cron-runs')
  if (existsSync(cronDir)) {
    try {
      for (const f of readdirSync(cronDir)) {
        if (!f.endsWith('.json')) continue
        try {
          const r = JSON.parse(readFileSync(join(cronDir, f), 'utf8'))
          if (args.repo && !r.repoLabel?.toLowerCase().includes(args.repo.toLowerCase())) continue
          if (args.status && r.status !== args.status) continue
          out.push({ ...r, source: 'cron' })
        } catch {}
      }
    } catch {}
  }
  return out.sort((a, b) => (b.startedAt || 0) - (a.startedAt || 0)).slice(0, args.limit || 50)
}

function aiSpendToday(args) {
  // Read ai-runs/ and roll up for today
  const dir = join(CFG, 'ai-runs')
  if (!existsSync(dir)) return { totalUsd: 0, totalRuns: 0, byModel: {}, byAgent: {} }
  const dayStart = (() => {
    const d = new Date()
    d.setHours(0, 0, 0, 0)
    return d.getTime()
  })()
  let totalUsd = 0
  let totalRuns = 0
  const byModel = {}
  const byAgent = {}
  try {
    for (const f of readdirSync(dir)) {
      if (!f.endsWith('.json')) continue
      try {
        const r = JSON.parse(readFileSync(join(dir, f), 'utf8'))
        if ((r.startedAt || 0) < dayStart) continue
        if (args.repo) {
          const b = basename(r.repoRoot || '')
          if (!b.toLowerCase().includes(args.repo.toLowerCase())) continue
        }
        if (args.agent && r.agentId !== args.agent) continue
        totalUsd += r.costUsd || 0
        totalRuns++
        byModel[r.model] = (byModel[r.model] || 0) + (r.costUsd || 0)
        if (r.agentId) byAgent[r.agentId] = (byAgent[r.agentId] || 0) + (r.costUsd || 0)
      } catch {}
    }
  } catch {}
  return { totalUsd, totalRuns, byModel, byAgent }
}

// ===========================================================================
// WRITE TOOLS — deterministic data filing. Agents skip reading SKILL.md.
// ===========================================================================

// --- file_ticket ----------------------------------------------------------

function fileTicket(args) {
  const { repo, title, body = '', type = 'feature', priority = 'medium', status = 'open', source = 'mcp' } = args
  if (!title) throw new Error('title is required')
  const repoRoot = findRepoRoot(repo)
  if (!repoRoot) throw new Error(`no repo matching "${repo}"`)
  const backlogDir = join(repoRoot, 'backlog')
  if (!existsSync(backlogDir)) throw new Error(`${repoRoot}/backlog/ does not exist`)
  // Vault-mode (Cross-Project ADR-0002): a .projection marker brands this
  // backlog as a read-only view — the write goes to the vault instead.
  if (hasProjectionMarker(backlogDir)) {
    const route = resolveRoute(repoRoot, readSettings() ?? {}, process.env)
    // The marker is an ABSOLUTE write guard: a carve-out-listed repo with a
    // marker is a configuration conflict, never a view write.
    if (route.mode !== 'vault') {
      throw new Error(`backlog/ has a .projection marker but "${route.slug}" is carve-out-listed — fix settings.vaultCarveOuts (ADR-0002)`)
    }
    if (existsSync(route.vaultPath)) {
      const r = createVaultTicketFile(route, { title, body, type, priority, status, source })
      const padded = String(r.sourceId).padStart(4, '0')
      emitActivityRaw({ kind: 'ticket-filed', title: `Ticket filed · #${padded}`, detail: title, repo: basename(repoRoot), repoRoot })
      // slug keeps the projected backlog shape so update_ticket round-trips
      // (it derives source_id from the first 4 chars); id stays zero-padded
      return { slug: `${padded}-${slugify(title)}`, id: padded, path: r.path }
    }
    // Vault unreachable (volume unmounted) — queue atomically, warn loudly
    const pendingDir = join(backlogDir, '.pending')
    mkdirSync(pendingDir, { recursive: true })
    const r = createTicketFile(pendingDir, { title, body, type, priority, status, source })
    emitActivityRaw({ kind: 'error', title: 'Vault unreachable — ticket queued', detail: `${title} → backlog/.pending/`, repo: basename(repoRoot), repoRoot })
    return { slug: r.slug, id: String(r.id).padStart(4, '0'), path: r.path, pending: true }
  }
  // Consolidated writer (vault TerMinal-001): one allocator (max of existing
  // files vs .next-id hint, atomic create with reallocation on a lost race)
  // and one frontmatter shape, shared with the app and terminal-cli.
  const { slug, id, path } = createTicketFile(backlogDir, { title, body, type, priority, status, source })
  const padded = String(id).padStart(4, '0')
  // Emit activity event so the harness picks it up
  emitActivityRaw({ kind: 'ticket-filed', title: `Ticket filed · #${padded}`, detail: title, repo: basename(repoRoot), repoRoot })
  // id stays the zero-padded string this tool has always returned
  return { slug, id: padded, path }
}

// --- update_ticket --------------------------------------------------------

function updateTicket(args) {
  const { slug, status, priority, appendPrUrl, removePrUrl } = args
  if (!slug) throw new Error('slug is required')
  let path = null
  for (const root of knownRepoRoots()) {
    const p = join(root, 'backlog', `${slug}.md`)
    if (existsSync(p)) {
      path = p
      break
    }
  }
  if (!path) {
    // No view file anywhere — a vault-mode ticket can exist before the
    // projection regenerates (file_ticket → immediate update_ticket).
    // source_id is per PROJECT, so the same NNNN exists in many repos:
    // disambiguate by the slug's title suffix (both sides use the same
    // slugify) and REFUSE on zero or multiple matches (review finding —
    // first-match patched the wrong repo's task).
    const srcId = parseInt(slug.slice(0, 4), 10)
    const suffix = slug.slice(5)
    if (Number.isFinite(srcId) && suffix) {
      const candidates = []
      for (const root of knownRepoRoots()) {
        if (!hasProjectionMarker(join(root, 'backlog'))) continue
        const route = resolveRoute(root, readSettings() ?? {}, process.env)
        if (route.mode !== 'vault') continue
        const vaultTask = findVaultTaskBySourceId(route.vaultPath, route.slug, srcId)
        if (!vaultTask) continue
        try {
          const h1 = readFileSync(vaultTask, 'utf8').match(/^# (.+)$/m)?.[1] ?? ''
          if (slugify(h1) === suffix) candidates.push(vaultTask)
        } catch {
          /* unreadable — not a candidate */
        }
      }
      if (candidates.length === 1) {
        if (!updateTicketFile(candidates[0], { status, priority, appendPrUrl, removePrUrl })) {
          throw new Error(`malformed frontmatter in ${candidates[0]}`)
        }
        return { ok: true, path: candidates[0] }
      }
      if (candidates.length > 1) {
        throw new Error(`ticket ${slug} is ambiguous across ${candidates.length} projected repos — regenerate the projection or patch the vault task directly`)
      }
    }
    throw new Error(`ticket ${slug} not found in any known repo`)
  }
  // Vault-mode (ADR-0002): a projected ticket's filename carries the
  // source_id — patch the vault task that owns it, never the view.
  const backlogDir = dirname(path)
  if (hasProjectionMarker(backlogDir)) {
    const route = resolveRoute(dirname(backlogDir), readSettings() ?? {}, process.env)
    if (route.mode !== 'vault') {
      throw new Error(`backlog/ has a .projection marker but "${route.slug}" is carve-out-listed — fix settings.vaultCarveOuts (ADR-0002)`)
    }
    const srcId = parseInt(slug.slice(0, 4), 10)
    const vaultTask = Number.isFinite(srcId)
      ? findVaultTaskBySourceId(route.vaultPath, route.slug, srcId)
      : null
    if (!vaultTask) throw new Error(`projected ticket ${slug} has no vault task (source_id ${srcId})`)
    if (!updateTicketFile(vaultTask, { status, priority, appendPrUrl, removePrUrl })) {
      throw new Error(`malformed frontmatter in ${vaultTask}`)
    }
    return { ok: true, path: vaultTask }
  }
  // Consolidated writer (shared with the app's tickets:update IPC)
  if (!updateTicketFile(path, { status, priority, appendPrUrl, removePrUrl })) {
    throw new Error(`malformed frontmatter in ${path}`)
  }
  return { ok: true, path }
}

// --- file_hitl ------------------------------------------------------------

function fileHitlTool(args) {
  const { title, action, detail, repo, source = 'agent', runId, ticketPath } = args
  if (!title) throw new Error('title is required')
  const cfg = join(process.env.HOME || '', '.config', 'TerMinal')
  mkdirSync(cfg, { recursive: true })
  const file = join(cfg, 'hitl.json')
  let list = []
  try {
    if (existsSync(file)) {
      const arr = JSON.parse(readFileSync(file, 'utf8'))
      if (Array.isArray(arr)) list = arr
    }
  } catch {}
  const item = {
    id: randomUUID(),
    title,
    action,
    detail,
    repo,
    source,
    status: 'open',
    createdAt: Date.now(),
    runId,
    ticketPath,
  }
  writeFileSync(file, JSON.stringify([item, ...list], null, 2))
  emitActivityRaw({ kind: 'blocked', title: `HITL · ${title}`, detail: action || detail || '', repo, hitlId: item.id, runId })
  // Telegram ping (best-effort, with inline buttons)
  try {
    const settings = JSON.parse(readFileSync(join(cfg, 'settings.json'), 'utf8'))?.telegram
    if (settings?.botToken && settings?.chatId) {
      const row = [{ text: '✅ Resolve', callback_data: `hitl:resolve:${item.id}` }]
      if (runId) row.push({ text: '🪵 Tail run', callback_data: `run:tail:${runId}` })
      fetch(`https://api.telegram.org/bot${settings.botToken}/sendMessage`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          chat_id: settings.chatId,
          text: `⛔ HITL · ${title}${action ? ` — ${action}` : ''}`,
          reply_markup: { inline_keyboard: [row] },
        }),
        signal: AbortSignal.timeout(8000),
      }).catch(() => {})
    }
  } catch {}
  return { id: item.id }
}

// --- resolve_hitl ---------------------------------------------------------

function resolveHitlTool(args) {
  const { id, resolved = true } = args
  if (!id) throw new Error('id is required')
  const file = join(process.env.HOME || '', '.config', 'TerMinal', 'hitl.json')
  let list = []
  try {
    list = JSON.parse(readFileSync(file, 'utf8'))
  } catch {
    return { ok: false }
  }
  const idx = list.findIndex((h) => h.id === id)
  if (idx < 0) return { ok: false }
  list[idx] = {
    ...list[idx],
    status: resolved ? 'resolved' : 'open',
    resolvedAt: resolved ? Date.now() : undefined,
  }
  writeFileSync(file, JSON.stringify(list, null, 2))
  return { ok: true }
}

// --- emit_activity --------------------------------------------------------

function emitActivityRaw({ kind, title, detail, repo, repoRoot, hitlId, runId }) {
  const cfg = join(process.env.HOME || '', '.config', 'TerMinal')
  mkdirSync(cfg, { recursive: true })
  const file = join(cfg, 'activity.jsonl')
  const ev = {
    id: randomUUID(),
    ts: Date.now(),
    kind: kind || 'info',
    title: title || '',
    detail: detail || '',
    repo: repo || '',
    repoRoot: repoRoot || '',
    ...(hitlId ? { hitlId } : {}),
    ...(runId ? { runId, runSource: 'agent' } : {}),
  }
  try {
    appendFileSync(file, JSON.stringify(ev) + '\n')
  } catch {}
  return ev
}

function emitActivityTool(args) {
  emitActivityRaw(args)
  return { ok: true }
}

// --- set_agent_state / get_agent_state -----------------------------------

function stateFilePath(repoArg, agentId) {
  if (!repoArg) throw new Error('repo is required')
  if (!agentId) throw new Error('agent is required')
  const root = findRepoRoot(repoArg)
  const slug = root ? basename(root) : repoArg
  return join(process.env.HOME || '', '.config', 'TerMinal', 'agent-state', slug, `${agentId}.json`)
}

function setAgentStateTool(args) {
  const { repo, agent, key, value } = args
  if (!key) throw new Error('key is required')
  const file = stateFilePath(repo, agent)
  mkdirSync(dirname(file), { recursive: true })
  let state = {}
  try {
    if (existsSync(file)) state = JSON.parse(readFileSync(file, 'utf8'))
  } catch {}
  state[key] = value
  state.lastRunAt = Date.now()
  writeFileSync(file, JSON.stringify(state, null, 2) + '\n')
  return { ok: true }
}

function getAgentStateTool(args) {
  const { repo, agent, key } = args
  const file = stateFilePath(repo, agent)
  if (!existsSync(file)) return key ? { value: null } : { state: {} }
  try {
    const s = JSON.parse(readFileSync(file, 'utf8'))
    return key ? { value: s[key] ?? null } : { state: s }
  } catch {
    return key ? { value: null } : { state: {} }
  }
}

// --- list_activity --------------------------------------------------------

function listActivityTool(args) {
  const { kind, repo, sinceMs, limit = 50 } = args || {}
  const file = join(process.env.HOME || '', '.config', 'TerMinal', 'activity.jsonl')
  if (!existsSync(file)) return []
  let raw = ''
  try {
    raw = readFileSync(file, 'utf8')
  } catch {
    return []
  }
  const events = []
  for (const line of raw.split('\n')) {
    if (!line.trim()) continue
    try {
      const ev = JSON.parse(line)
      if (kind && ev.kind !== kind) continue
      if (repo && !(ev.repo || '').toLowerCase().includes(repo.toLowerCase())) continue
      if (sinceMs && ev.ts < sinceMs) continue
      events.push(ev)
    } catch {}
  }
  return events.slice(-limit).reverse()
}

// --- list_hitl ------------------------------------------------------------

function listHitlTool(args) {
  const { status = 'open', repo, limit = 50 } = args || {}
  const file = join(process.env.HOME || '', '.config', 'TerMinal', 'hitl.json')
  if (!existsSync(file)) return []
  try {
    const arr = JSON.parse(readFileSync(file, 'utf8'))
    return arr
      .filter((h) => (status === 'all' ? true : h.status === status))
      .filter((h) => !repo || (h.repo || '').toLowerCase().includes(repo.toLowerCase()))
      .slice(0, limit)
  } catch {
    return []
  }
}

// --- list_bg_tasks --------------------------------------------------------

function listBgTasksTool(args) {
  const { status, repo, limit = 20 } = args || {}
  const file = join(process.env.HOME || '', '.config', 'TerMinal', 'bg-tasks.json')
  if (!existsSync(file)) return []
  try {
    const arr = JSON.parse(readFileSync(file, 'utf8'))
    return arr
      .filter((t) => !status || t.status === status)
      .filter((t) => !repo || (t.repo || '').toLowerCase().includes(repo.toLowerCase()))
      .slice(0, limit)
  } catch {
    return []
  }
}

// --- harness_status -------------------------------------------------------

function harnessStatusTool() {
  const cfg = join(process.env.HOME || '', '.config', 'TerMinal')
  const hitlFile = join(cfg, 'hitl.json')
  let hitlOpen = 0
  try {
    if (existsSync(hitlFile)) {
      const arr = JSON.parse(readFileSync(hitlFile, 'utf8'))
      hitlOpen = arr.filter((h) => h.status === 'open').length
    }
  } catch {}
  const cronDir = join(cfg, 'cron-runs')
  let cronRunning = 0
  let cronFailed24h = 0
  if (existsSync(cronDir)) {
    const dayAgo = Date.now() - 86_400_000
    try {
      for (const f of readdirSync(cronDir)) {
        if (!f.endsWith('.json')) continue
        try {
          const r = JSON.parse(readFileSync(join(cronDir, f), 'utf8'))
          if (r.status === 'running') cronRunning++
          if (r.status === 'failed' && r.startedAt >= dayAgo) cronFailed24h++
        } catch {}
      }
    } catch {}
  }
  let bgRunning = 0
  try {
    const bf = join(cfg, 'bg-tasks.json')
    if (existsSync(bf)) {
      const arr = JSON.parse(readFileSync(bf, 'utf8'))
      bgRunning = arr.filter((t) => t.status === 'running').length
    }
  } catch {}
  const spend = aiSpendToday({})
  return {
    hitlOpen,
    cronRunning,
    cronFailed24h,
    bgRunning,
    spendTodayUsd: spend.totalUsd,
    spendByModel: spend.byModel,
  }
}

// --- set_run_outcome ------------------------------------------------------

function setRunOutcomeTool(args) {
  const { runId, outcome } = args
  if (!runId || !outcome) throw new Error('runId and outcome are required')
  const dir = join(process.env.HOME || '', '.config', 'TerMinal', 'ai-runs')
  if (!existsSync(dir)) return { ok: false, reason: 'no ai-runs/ dir' }
  // Find the AIRun by runId (the harness id), not the AIRun file's own id
  let updated = 0
  for (const f of readdirSync(dir)) {
    if (!f.endsWith('.json')) continue
    const path = join(dir, f)
    try {
      const r = JSON.parse(readFileSync(path, 'utf8'))
      if (r.runId === runId) {
        r.outcome = outcome
        writeFileSync(path, JSON.stringify(r, null, 2))
        updated++
      }
    } catch {}
  }
  return { ok: updated > 0, updated }
}

// ---------------------------------------------------------------------------
// Cross-repo + repo-introspection tools added 2026-05-30. These close the
// "agents can self-query the IDE" gap: list_agents (what agents exist),
// list_review_patterns (top clusters from review-findings miner),
// factory_health (cross-repo rollup), search_decisions (grep ADRs +
// learnings), recent_changes (git log digest), nearest_session (find a
// related Claude session by repo/branch).
// ---------------------------------------------------------------------------

// --- list_agents: what agents are available for a repo --------------------
function listAgentsTool(args) {
  const root = args.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null
  if (!root) return { error: 'unknown repo; pass repo=<basename> or set TERMINAL_REPO' }
  const out = []
  // Repo-local: .agents/agents.json + .agents/*.sh
  const localJson = join(root, '.agents', 'agents.json')
  if (existsSync(localJson)) {
    try {
      const list = JSON.parse(readFileSync(localJson, 'utf8'))
      const arr = Array.isArray(list) ? list : Array.isArray(list?.agents) ? list.agents : []
      for (const a of arr) {
        if (a?.id && a?.title) out.push({ id: a.id, title: a.title, source: 'repo', force: !!a.force, opensPr: !!a.opensPr, inPlace: !!a.inPlace, description: a.description })
      }
    } catch {}
  }
  if (existsSync(join(root, '.agents'))) {
    try {
      for (const f of readdirSync(join(root, '.agents'))) {
        if (!f.endsWith('.sh')) continue
        const id = f.slice(0, -3)
        if (out.find((a) => a.id === id)) continue
        out.push({ id, title: id, source: 'repo-script' })
      }
    } catch {}
  }
  // Global script agents
  const globalScripts = join(CFG, 'scripts')
  if (existsSync(globalScripts)) {
    try {
      for (const f of readdirSync(globalScripts)) {
        if (!f.endsWith('.sh')) continue
        const id = f.slice(0, -3)
        if (out.find((a) => a.id === id)) continue
        out.push({ id, title: id, source: 'global-script' })
      }
    } catch {}
  }
  return { repo: basename(root), agents: out.sort((a, b) => a.id.localeCompare(b.id)) }
}

// --- list_review_patterns: read <harnessDir>/reports/review-patterns.md
function listReviewPatternsTool(args) {
  const harness = configuredHarnessDir()
  if (!harness) return { error: 'no harnessDir configured in ~/.config/TerMinal/settings.json' }
  const path = join(harness, 'reports', 'review-patterns.md')
  if (!existsSync(path)) return { error: 'no review patterns report yet; runs nightly via bin/review-findings-mine' }
  const limit = typeof args?.limit === 'number' ? Math.max(1, Math.min(50, args.limit)) : 10
  const raw = readFileSync(path, 'utf8')
  // Each cluster is a `## ` heading block. Parse heading + first 3 list items
  // (representative tokens + count + N-repos) into an array.
  const out = []
  const sections = raw.split(/^## /m).slice(1)
  for (const sec of sections) {
    const lines = sec.split('\n')
    const title = (lines[0] || '').trim()
    const meta = lines.slice(1, 12).filter((l) => l.trim()).slice(0, 8)
    out.push({ title, summary: meta.join('\n') })
    if (out.length >= limit) break
  }
  return { count: out.length, patterns: out }
}

// --- factory_health: cross-repo rollup from per-repo state files ----------
function factoryHealthTool() {
  const out = []
  for (const root of knownRepoRoots()) {
    const repo = basename(root)
    const repoOut = { repo, ticketCounts: { open: 0, inProgress: 0, closed: 0, stuck: 0, icebox: 0 }, openPrs: 0 }
    // Tickets
    const backlog = join(root, 'backlog')
    if (existsSync(backlog)) {
      try {
        for (const f of readdirSync(backlog)) {
          if (!/^\d{4}-.*\.md$/.test(f)) continue
          try {
            const { meta } = parseFrontmatter(readFileSync(join(backlog, f), 'utf8'))
            const s = meta.status || 'open'
            if (s === 'open') repoOut.ticketCounts.open++
            else if (s === 'in-progress') repoOut.ticketCounts.inProgress++
            else if (s === 'closed') repoOut.ticketCounts.closed++
            else if (s === 'stuck') repoOut.ticketCounts.stuck++
            else if (s === 'icebox') repoOut.ticketCounts.icebox++
          } catch {}
        }
      } catch {}
    }
    out.push(repoOut)
  }
  // Open PR count (from prs/cache.json)
  try {
    const root = prsRoot()
    if (!root) return { repos: out.sort((a, b) => b.ticketCounts.open - a.ticketCounts.open) }
    const cf = join(root, 'cache.json')
    if (existsSync(cf)) {
      const cache = JSON.parse(readFileSync(cf, 'utf8'))
      const prs = Array.isArray(cache?.prs) ? cache.prs : []
      for (const pr of prs) {
        const repoBase = basename(String(pr.repo || ''))
        const r = out.find((x) => x.repo === repoBase || pr.repo?.endsWith(x.repo))
        if (r && (pr.state || '').toLowerCase() === 'open') r.openPrs++
      }
    }
  } catch {}
  return { repos: out.sort((a, b) => b.ticketCounts.open - a.ticketCounts.open) }
}

// --- search_decisions: grep docs/decisions + docs/learnings for a query ---
function searchDecisionsTool(args) {
  const q = (args?.query || '').trim().toLowerCase()
  if (!q) return { error: 'query is required' }
  const limit = typeof args?.limit === 'number' ? Math.max(1, Math.min(50, args.limit)) : 20
  const repoArg = args?.repo
  const roots = repoArg ? [findRepoRoot(repoArg)].filter(Boolean) : knownRepoRoots()
  const out = []
  for (const root of roots) {
    for (const sub of ['docs/decisions', 'docs/learnings', 'docs/runbooks']) {
      const dir = join(root, sub)
      if (!existsSync(dir)) continue
      let entries
      try { entries = readdirSync(dir) } catch { continue }
      for (const f of entries) {
        if (!f.endsWith('.md')) continue
        const path = join(dir, f)
        let raw
        try { raw = readFileSync(path, 'utf8') } catch { continue }
        const lower = raw.toLowerCase()
        if (!lower.includes(q)) continue
        const { meta, body } = parseFrontmatter(raw)
        // First matching line (with a few chars context) for the snippet
        const idx = lower.indexOf(q)
        const lineStart = lower.lastIndexOf('\n', idx) + 1
        const lineEnd = lower.indexOf('\n', idx)
        const snippet = raw.slice(lineStart, lineEnd > 0 ? lineEnd : lineStart + 200)
        out.push({
          repo: basename(root),
          path: path.replace(homedir(), '~'),
          kind: sub.split('/')[1], // decisions|learnings|runbooks
          title: meta.title || f.replace(/\.md$/, ''),
          status: meta.status,
          tags: meta.tags,
          snippet: snippet.trim().slice(0, 200),
        })
        if (out.length >= limit) return { count: out.length, hits: out }
      }
    }
  }
  return { count: out.length, hits: out }
}

// --- recent_changes: git log digest for a repo since N days ago -----------
function recentChangesTool(args) {
  const root = args?.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null
  if (!root) return { error: 'unknown repo; pass repo=<basename> or set TERMINAL_REPO' }
  const days = typeof args?.days === 'number' ? Math.max(1, Math.min(90, args.days)) : 7
  const limit = typeof args?.limit === 'number' ? Math.max(1, Math.min(200, args.limit)) : 50
  try {
    const { execFileSync } = require('node:child_process')
    const out = execFileSync(
      'git',
      ['-C', root, 'log', `--since=${days} days ago`, `-n`, String(limit), '--pretty=format:%h|%an|%ar|%s'],
      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] },
    )
    const commits = out
      .split('\n')
      .filter(Boolean)
      .map((line) => {
        const [sha, author, when, ...subjectParts] = line.split('|')
        return { sha, author, when, subject: subjectParts.join('|') }
      })
    return { repo: basename(root), days, count: commits.length, commits }
  } catch (e) {
    return { error: `git log failed: ${e.message}` }
  }
}

// --- nearest_session: find recent Claude session transcripts for a repo ---
function nearestSessionTool(args) {
  const root = args?.repo ? findRepoRoot(args.repo) : process.env.TERMINAL_REPO || null
  if (!root) return { error: 'unknown repo; pass repo=<basename> or set TERMINAL_REPO' }
  const limit = typeof args?.limit === 'number' ? Math.max(1, Math.min(20, args.limit)) : 5
  // Claude transcript naming convention: dir slugifies the cwd path.
  const slug = '-' + root.replace(/^\//, '').replace(/\//g, '-')
  const dir = join(homedir(), '.claude', 'projects', slug)
  if (!existsSync(dir)) return { repo: basename(root), sessions: [], hint: `no transcript dir at ~/.claude/projects/${slug}` }
  let files
  try { files = readdirSync(dir) } catch { return { error: `cannot read ${dir}` } }
  const sessions = files
    .filter((f) => f.endsWith('.jsonl'))
    .map((f) => {
      const path = join(dir, f)
      let stat
      try { stat = statSync(path) } catch { return null }
      return { id: f.replace(/\.jsonl$/, ''), modifiedMs: stat.mtimeMs, sizeBytes: stat.size, path: path.replace(homedir(), '~') }
    })
    .filter(Boolean)
    .sort((a, b) => b.modifiedMs - a.modifiedMs)
    .slice(0, limit)
  return { repo: basename(root), count: sessions.length, sessions }
}

